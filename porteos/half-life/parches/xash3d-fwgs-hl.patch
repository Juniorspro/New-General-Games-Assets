+/*
+=================
+Porteo_Necesita
+
+Porteo web (Half-Life): el mapa que se va a cargar con una partida nueva, una guardada o el paso
+al siguiente (con su landmark). Si todavía no se bajó, la página lo trae y vuelve a mandar el
+comando que lo carga.
+=================
+*/
+qboolean Porteo_Necesita( const char *mapa, const char *comando )
+{
+	return EM_ASM_INT({
+		return Module.porteoNecesita ? Module.porteoNecesita( UTF8ToString( $0 ), UTF8ToString( $1 )) : 1;
+	}, mapa, comando ) != 0;
+}
+
+// Si el nivel siguiente no se pudo bajar, el juego sale de la pausa en la que esperaba
