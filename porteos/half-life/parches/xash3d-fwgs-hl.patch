+#if XASH_EMSCRIPTEN
+	// porteo web: el dladdr() de Emscripten es un stub sin nombres, y sin nombres guardar la partida
+	// o pasar de nivel deja a las entidades sin sus funciones (trenes, puertas, disparadores).
+	// Un puntero a función es un índice de la tabla: se busca qué exportación de la biblioteca es.
+	// El mapa de función a nombre se arma una vez por biblioteca; si dos nombres son la misma
+	// función, gana el de C++ (_ZN), que es el que se sabe convertir. (Sin comas sueltas: EM_ASM
+	// es una macro y las tomaría como otro argumento)
+	static string name;
+
+	if( EM_ASM_INT({
+		var lib = LDSO.loadedLibsByHandle[$0];
+		if( !lib || !lib.exports || !$1 || $1 >= wasmTable.length ) return 0;
+		var f = wasmTable.get( $1 );
+		if( !f ) return 0;
+		if( !lib.porteoNombres )
+		{
+			var m = new Map();
+			for( var k in lib.exports )
+			{
+				var v = lib.exports[k];
+				if( typeof v != 'function' || v.stub ) continue;
+				var antes = m.get( v );
+				if( antes === undefined || ( !antes.startsWith( '_ZN' ) && k.startsWith( '_ZN' ))) m.set( v, k );
+			}
+			lib.porteoNombres = m;
+		}
+		var n = lib.porteoNombres.get( f );
+		if( !n ) return 0;
+		stringToUTF8( n, $2, $3 );
+		return 1;
+	}, hInstance, function, name, sizeof( name )))
+		return COM_GetPlatformNeutralName( name );
+
+	return NULL;
+#else
 	// NOTE: dladdr() is a glibc extension
 	Dl_info info = {0};
 	int ret = dladdr( (void*)function, &info );
@@ -371,6 +409,7 @@ const char *COM_NameForFunction( void *hInstance, void *function )
 #else
 	return NULL;
 #endif
+#endif // XASH_EMSCRIPTEN
 }
 
