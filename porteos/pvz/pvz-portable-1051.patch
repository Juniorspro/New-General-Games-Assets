+{
+	if (!gDatosOriginales)
+		return theMgr.GetImageThrow(theId);
+	// nullptr = sin reemplazo: la pista conserva su imagen original
+	return theIdViejo != nullptr ? (Image*)theMgr.GetImage(theIdViejo) : nullptr;
+}
+
+static intptr_t SonidoGoty(ResourceManager& theMgr, const char* theId)
+{
+	if (!gDatosOriginales)
+		return theMgr.GetSoundThrow(theId);
+	return theMgr.GetSound(theId);  // -1 si no está: ReportAchievement no lo toca con estos datos
+}
