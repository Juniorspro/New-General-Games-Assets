 #include "SexyAppFramework/SexyApp.h"
 #include "PvzpLib/PvzpFoley.h"
 #include <memory>
+#ifdef __EMSCRIPTEN__
+#include <coroutine>
+#include <utility>
+
+// porteo: una corrutina mínima. La carga del juego queda escrita de corrido, como en el hilo
+// de carga del original, pero se suspende en cada co_yield y el bucle principal la retoma
+// en el cuadro siguiente (en la web no hay hilos).
+class TareaDeCarga
+{
+public:
+	struct promise_type
+	{
+		TareaDeCarga get_return_object() { return TareaDeCarga(std::coroutine_handle<promise_type>::from_promise(*this)); }
+		std::suspend_always initial_suspend() noexcept { return {}; }
+		std::suspend_always final_suspend() noexcept { return {}; }
+		std::suspend_always yield_value(int theValor) noexcept { mEsperando = theValor == ESPERAR; return {}; }
+		void return_void() noexcept {}
+		void unhandled_exception() { throw; }
+		bool mEsperando = false;
+	};
+
+	// co_yield SEGUIR: hizo un pedazo de trabajo y puede seguir en este cuadro.
+	// co_yield ESPERAR: espera algo que trae el tiempo (el logo quieto): nada más por este cuadro.
+	static constexpr int SEGUIR = 0, ESPERAR = 1;
+
+	explicit TareaDeCarga(std::coroutine_handle<promise_type> theManija) : mManija(theManija) {}
+	TareaDeCarga(TareaDeCarga&& theOtra) noexcept : mManija(std::exchange(theOtra.mManija, {})) {}
+	TareaDeCarga(const TareaDeCarga&) = delete;
+	TareaDeCarga& operator=(const TareaDeCarga&) = delete;
+	~TareaDeCarga() { if (mManija) mManija.destroy(); }
+
+	// Corre hasta el próximo co_yield; true cuando ya no queda nada.
+	bool Avanzar()
+	{
+		if (mManija && !mManija.done())
+			mManija.resume();
+		return !mManija || mManija.done();
+	}
+
+	// El último co_yield fue ESPERAR.
+	bool Esperando() const { return mManija && !mManija.done() && mManija.promise().mEsperando; }
+
+private:
+	std::coroutine_handle<promise_type> mManija;
+};
+#endif
 
