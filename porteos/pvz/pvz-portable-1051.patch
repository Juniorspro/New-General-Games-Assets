+// porteo 1051: el bailarín de 2009 (Zombie_Jackson / Zombie_dancer) nombra distinto las
+// pistas del brazo que el "disco" de la GOTY. Sin este alias el brazo caído usaba la
+// pista 0 (posición y imagen equivocadas).
+static const char* PistaLegada(const char* theTrackName)
+{
+	static constexpr const char* aAlias[][2] = {
+		{ "Zombie_disco_outerarm_lower", "Zombie_outerarm_lower" },
+		{ "Zombie_disco_outerarm_upper", "Zombie_Jackson_outerarm_upper" },
+		{ "Zombie_disco_outerhand", "Zombie_outerarm_hand" },
+		{ "Zombie_disco_outerhand_point", "Zombie_outerarm_hand" },
+	};
+	for (const auto& aPar : aAlias)
+		if (strcasecmp(theTrackName, aPar[0]) == 0)
+			return aPar[1];
+	return nullptr;
+}
+
 int Reanimation::FindTrackIndex(const char* theTrackName)
 {
 	for (int aTrackIndex = 0; aTrackIndex < mDefinition->mTracks.count; aTrackIndex++)
 		if (strcasecmp(mDefinition->mTracks.tracks[aTrackIndex].mName, theTrackName) == 0)
 			return aTrackIndex;
 
+	if (const char* aLegada = PistaLegada(theTrackName))
+		for (int aTrackIndex = 0; aTrackIndex < mDefinition->mTracks.count; aTrackIndex++)
+			if (strcasecmp(mDefinition->mTracks.tracks[aTrackIndex].mName, aLegada) == 0)
+				return aTrackIndex;
+
 	PvzpLogLn("Can't find track '{}'", theTrackName);
 	return 0;
 }
