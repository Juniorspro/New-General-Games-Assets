+// quedaba negra o congelada ~12 s y recién después corrían 3 s de logo y título.
+TareaDeCarga LawnApp::CargaPorPartes()
+{
+	if (!PvzpLoadResources("LoaderBar"))
+		co_return;
+
+	PvzpStringListLoad("Properties/LawnStrings.txt");
+	PvzpStringListReadFile("Properties/ZombatarTOS.txt");
+	LoadProperties("properties/default.xml", false, false);
+	LoadProperties("properties/Layout.xml", false, false);
+	LoadProperties("properties/pvz-portable.xml", false, false);
+	if (mTitleScreen)
+		mTitleScreen->mLoaderScreenIsLoaded = true;
+
+	const char* aGrupos[] = { "LoadingFonts", "LoadingImages", "LoadingSounds" };
+	int aPesos[] = { 54, 9, 54 };
+	for (int i = 0; i < 3; i++)
+		mNumLoadingThreadTasks += mResourceManager->GetNumResources(aGrupos[i]) * aPesos[i];
+	mNumLoadingThreadTasks += 636;
+	mNumLoadingThreadTasks += GetNumPreloadingTasks();
+	mNumLoadingThreadTasks += Music::MUSIC_LOADING_TASKS;
+	constexpr int PESO_ANIMACION = 40;
+	mNumLoadingThreadTasks += ReanimatorCantidadDeDefiniciones() * PESO_ANIMACION;
+	co_yield TareaDeCarga::SEGUIR;
+
+	// La música no se puede partir: cada mainmusic.mo3 son 20 MB de muestras Vorbis a
+	// decodificar (2,5 s en un teléfono), y hay dos (melodía y batería). Se cargan con el logo
+	// de PopCap ya entero y quieto, que es cuando una espera no se nota.
+	while (mTitleScreen && mTitleScreen->mTitleState == TitleState::TITLESTATE_POPCAP_LOGO &&
+		mTitleScreen->mTitleStateCounter > mTitleScreen->mTitleStateDuration - 50)
+		co_yield TareaDeCarga::ESPERAR;
+	mMusic->MusicTitleScreenInit();
+	co_yield TareaDeCarga::SEGUIR;
+	mMusic->MusicInit();
+	co_yield TareaDeCarga::SEGUIR;
+
+	static constexpr std::pair<const char*, int> aGruposIniciales[] = { { "LoadingImages", 9 }, { "LoadingFonts", 54 } };
+	for (const auto& [aGrupo, aPeso] : aGruposIniciales)
+	{
+		mResourceManager->StartLoadResources(aGrupo);
+		while (!mShutdown && !mCloseRequest && !mLoadingFailed && PvzpLoadNextResource())
+		{
+			mCompletedLoadingThreadTasks += aPeso;
+			co_yield TareaDeCarga::SEGUIR;
+		}
+		if (mShutdown || mCloseRequest)
+			co_return;
+		if (mResourceManager->HadError() || !ExtractResourcesByName(mResourceManager.get(), aGrupo))
+		{
+			ShowResourceError();
+			mLoadingFailed = true;
+		}
+	}
+	if (mLoadingFailed || mShutdown || mCloseRequest)
+		co_return;
+	mDefaultFont = FONT_PICO129;
+
