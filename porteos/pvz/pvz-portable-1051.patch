+// porteo: el estado del juego para las pruebas automáticas (porteos/pvz/prueba.mjs).
+// Medir "sol 150 → 50 al plantar" vale más que "no hubo errores en la consola".
+extern "C" EMSCRIPTEN_KEEPALIVE const char* porteo_estado()
+{
+	static std::string aJson;
+	LawnApp* aApp = gLawnApp;
+	if (aApp == nullptr)
+		return "{}";
+	auto aTexto = [](const std::string& s) {
+		std::string r;
+		for (char c : s) { if (c == '"' || c == '\\') r += '\\'; if ((unsigned char)c >= 32) r += c; }
+		return r;
+	};
+	const char* aPantalla = "otro";
+	if (aApp->mTitleScreen) aPantalla = "titulo";
+	else if (aApp->mGameSelector) aPantalla = "menu";
+	else if (aApp->mAwardScreen) aPantalla = "premio";
+	else if (aApp->mCreditScreen) aPantalla = "creditos";
+	else if (aApp->mChallengeScreen) aPantalla = "desafios";
+	else if (aApp->mSeedChooserScreen) aPantalla = "elegir";
+	else if (aApp->mBoard) aPantalla = "tablero";
+	aJson = std::format("{{\"pantalla\":\"{}\",\"cargado\":{},\"dialogos\":{},\"dialogo\":{},\"modo\":{},\"musica\":{}",
+		aPantalla, aApp->mTitleScreen ? (aApp->mTitleScreen->mLoadingThreadComplete ? 1 : 0) : 1, aApp->mDialogMap.size(), aApp->mDialogMap.empty() ? -1 : aApp->mDialogMap.rbegin()->first,
+		(int)aApp->mGameMode, aApp->mMusic ? (int)aApp->mMusic->mCurMusicTune : -1);
+	// memoria del módulo (páginas de 64 KiB): en un teléfono es lo primero que se acaba
+	aJson += std::format(",\"memoria_mb\":{}", (int)(__builtin_wasm_memory_size(0) * 65536ULL / 1048576ULL));
+	// escena 3 = jugando; dave > 0 = Crazy Dave en pantalla (se avanza tocando)
+	aJson += std::format(",\"escena\":{},\"dave\":{}", (int)aApp->mGameScene, (int)aApp->mCrazyDaveState);
+	if (aApp->mPlayerInfo)
+		aJson += std::format(",\"jugador\":\"{}\",\"aventura\":{},\"monedas\":{}",
+			aTexto(aApp->mPlayerInfo->mName), aApp->mPlayerInfo->mLevel, aApp->mPlayerInfo->mCoins);
+	if (Board* aBoard = aApp->mBoard)
+	{
+		aJson += std::format(",\"nivel\":{},\"sol\":{},\"pausa\":{},\"completo\":{},\"cursor\":{},\"semilla\":{}",
+			aBoard->mLevel, aBoard->mSunMoney, aBoard->mPaused ? 1 : 0, aBoard->mLevelComplete ? 1 : 0,
+			aBoard->mCursorObject ? (int)aBoard->mCursorObject->mCursorType : -1,
+			aBoard->mCursorObject ? (int)aBoard->mCursorObject->mType : -1);
+		std::string aLista;
+		for (Plant* aPlant : aBoard->mPlants)
+			if (!aPlant->mDead)
+				aLista += std::format("{}[{},{},{}]", aLista.empty() ? "" : ",", aPlant->mPlantCol, aPlant->mRow, (int)aPlant->mSeedType);
+		aJson += ",\"plantas\":[" + aLista + "]";
+		aLista.clear();
+		for (Zombie* aZombie : aBoard->mZombies)
+			if (!aZombie->mDead)
+				aLista += std::format("{}[{},{},{}]", aLista.empty() ? "" : ",", (int)aZombie->mZombieType, (int)aZombie->mPosX, aZombie->mRow);
+		aJson += ",\"zombis\":[" + aLista + "]";
+		aLista.clear();
+		for (Coin* aCoin : aBoard->mCoins)
+			if (!aCoin->mDead && !aCoin->mIsBeingCollected)
+				aLista += std::format("{}[{},{},{}]", aLista.empty() ? "" : ",", (int)aCoin->mPosX, (int)aCoin->mPosY, (int)aCoin->mType);
+		aJson += ",\"soles\":[" + aLista + "]";
+	}
+	aJson += "}";
+	return aJson.c_str();
+}
+#endif
