+// porteo 1051: el main.pak original (1.0.0.1051, 2009) no trae lo que sumó la GOTY (logros,
+// Zombatar, "más formas de jugar") y tiene al bailarín de 2009 en lugar del "disco".
+// Con esos datos, lo que falta queda en blanco (esas pantallas no se ofrecen) y el
+// bailarín usa sus propias imágenes. Con datos GOTY todo sigue siendo obligatorio.
+static Image* ImagenGoty(ResourceManager& theMgr, const char* theId)
+{
+	if (!gDatosOriginales)
+		return theMgr.GetImageThrow(theId);
+	Image* aImagen = theMgr.GetImage(theId);
+	return aImagen != nullptr ? aImagen : (Image*)Sexy::IMAGE_BLANK;
