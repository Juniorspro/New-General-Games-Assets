+	co_yield TareaDeCarga::SEGUIR;
+
+	TrailLoadDefinitions(gLawnTrailArray, LENGTH(gLawnTrailArray));
+	co_yield TareaDeCarga::SEGUIR;
+
+	PvzpParticleBeginLoadDefinitions(gLawnParticleArray, LENGTH(gLawnParticleArray));
+	for (int i = 0; i < static_cast<int>(LENGTH(gLawnParticleArray)); i++)
+	{
+		PvzpParticleLoadDefinition(i);
+		co_yield TareaDeCarga::SEGUIR;
+	}
+
+	// PreloadForUser, de a una animación, planta o zombi
+	int aNumTasks = mCompletedLoadingThreadTasks + GetNumPreloadingTasks();
+	if (mTitleScreen && mTitleScreen->mQuickLoadKey != KeyCode::KEYCODE_UNKNOWN)
