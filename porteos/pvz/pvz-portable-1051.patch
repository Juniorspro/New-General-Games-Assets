+		static constexpr std::pair<ReanimationType, int> aFijas[] = {
+			{ ReanimationType::REANIM_PUFF, 0 }, { ReanimationType::REANIM_LAWN_MOWERED_ZOMBIE, 0 },
+			{ ReanimationType::REANIM_READYSETPLANT, 68 }, { ReanimationType::REANIM_FINAL_WAVE, 0 },
+			{ ReanimationType::REANIM_SUN, 0 }, { ReanimationType::REANIM_TEXT_FADE_ON, 68 },
+			{ ReanimationType::REANIM_ZOMBIE, 68 }, { ReanimationType::REANIM_ZOMBIE_NEWSPAPER, 68 },
+			{ ReanimationType::REANIM_SELECTOR_SCREEN, 340 }, { ReanimationType::REANIM_ZOMBIE_HAND, 68 }
+		};
+		for (const auto& [aTipo, aPeso] : aFijas)
+		{
+			ReanimatorEnsureDefinitionLoaded(aTipo, true);
+			mCompletedLoadingThreadTasks += aPeso;
+			co_yield TareaDeCarga::SEGUIR;
+		}
+
+		if (mPlayerInfo)
