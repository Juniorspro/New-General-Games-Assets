+
+// porteo: la pantalla ancha. Los fondos del jardín miden 1400 de ancho y el juego muestra 800:
+// a la izquierda del césped queda la casa (BOARD_OFFSET = 220 píxeles). En un teléfono apaisado
+// el 4:3 deja dos franjas negras enormes; mientras se ve el jardín, la pantalla se agranda hacia
+// la izquierda hasta gAnchoExtraMax (lo pide la carcasa según la forma de la pantalla) y muestra
+// la casa. A la derecha no: los zombis nacen apenas pasando el borde (x = 780…880) y con más
+// pantalla se los vería aparecer de golpe en la calle. El juego no cambia: sólo se ve más fondo.
+// Es una cámara: cuando el tablero se corre a la derecha (al empezar se mira la casa), la franja
+// no se pasa del borde del fondo y lo de más queda a la derecha.
+static int gAnchoExtraMax = 0;
+
+void LawnApp::AjustarPantalla()
+{
+	int aExtra = 0;
+	if (gAnchoExtraMax > 0 && mBoard && mBoard->mParent && mBoard->mVisible && !mAwardScreen && !mCreditScreen &&
+		mBoard->mBackground >= BackgroundType::BACKGROUND_1_DAY && mBoard->mBackground <= BackgroundType::BACKGROUND_6_BOSS)
+		aExtra = gAnchoExtraMax;
+
+	if (mGLInterface->mWidth != mWidth + aExtra)
+	{
+		SDL_SetWindowSize(static_cast<SDL_Window*>(mWindow), mWidth + aExtra, mHeight);
+		mGLInterface->CambiarAncho(mWidth + aExtra);
+		mWidgetManager->MarkAllDirty();
+	}
+	const int aCorrimiento = aExtra ? std::max(mBoard->mX - BOARD_OFFSET, -aExtra) : 0;
+	mScreenBounds = Rect(aCorrimiento, 0, mWidth + aExtra, mHeight);
+}
+
+bool LawnApp::AvanzarCarga(double theHasta)
+{
+	if (!mCargaPorPartes)
+		mCargaPorPartes = std::make_unique<TareaDeCarga>(CargaPorPartes());
+	// emscripten_get_now y no SDL_GetTicks: ésta pasa por gettimeofday y Date.now, y con
+	// miles de pasos chicos eran 0,13 s de la carga en un teléfono (CPU ÷4). Si la carga
+	// espera al logo, se corta el cuadro: si no, daba vueltas en el lugar los 50 ms.
+	while (!mCargaPorPartes->Avanzar())
+	{
+		if (mCargaPorPartes->Esperando() || emscripten_get_now() >= theHasta)
+			return false;
+	}
+	mCargaPorPartes.reset();
+	return true;
+}
