 	return aPFP;
 }
 
+#ifdef __EMSCRIPTEN__
+// porteo: en la web los recursos están en main.pak y en el disco (MEMFS) queda sólo lo que
+// escribe la carcasa (main.pak, properties/) y las partidas. Pero cada imagen de una animación
+// se busca en tres carpetas, con cuatro extensiones y dos nombres de alfa, y lo que no está en
+// el pak se va a buscar al disco: ~25 000 consultas a MEMFS, 1,2 s de la carga en un teléfono
+// (CPU ÷4). Los recursos no se escriben mientras se juega, así que alcanza con leer una vez
+// cada carpeta: si el nombre no está ni con otras mayúsculas (fcaseopen no las distingue), no
+// hace falta preguntar. Si está, se sigue por el camino de siempre.
+namespace
+{
+struct CarpetaEnDisco
+{
+	std::string										mRuta;		// como se llama en el disco
+	std::unordered_map<std::string, std::string>	mEntradas;	// nombre en minúsculas → como se llama
+};
+
+std::string Minusculas(std::string_view theTexto)
+{
+	std::string aTexto(theTexto);
+	for (char& c : aTexto)
+		c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+	return aTexto;
+}
+
+// theCarpeta: ruta absoluta en minúsculas sin barra final ("" es la raíz). nullptr si no existe.
+const CarpetaEnDisco* LeerCarpeta(const std::string& theCarpeta)
+{
+	static std::unordered_map<std::string, std::optional<CarpetaEnDisco>> aLeidas;
+	if (auto anItr = aLeidas.find(theCarpeta); anItr != aLeidas.end())
+		return anItr->second ? &*anItr->second : nullptr;
+
+	std::string aRuta;
+	if (theCarpeta.empty())
+		aRuta = "/";
+	else
+	{
+		const size_t aBarra = theCarpeta.rfind('/');
+		if (const CarpetaEnDisco* aMadre = LeerCarpeta(theCarpeta.substr(0, aBarra)))
+		{
+			auto anEntrada = aMadre->mEntradas.find(theCarpeta.substr(aBarra + 1));
+			if (anEntrada != aMadre->mEntradas.end())
+				aRuta = (aMadre->mRuta == "/" ? "/" : aMadre->mRuta + "/") + anEntrada->second;
+		}
+	}
+
+	std::optional<CarpetaEnDisco> aCarpeta;
+	std::error_code ec;
+	if (!aRuta.empty() && std::filesystem::is_directory(aRuta, ec))
+	{
+		aCarpeta.emplace();
+		aCarpeta->mRuta = aRuta;
+		for (const auto& anEntrada : std::filesystem::directory_iterator(aRuta, ec))
+		{
+			std::string aNombre = anEntrada.path().filename().string();
+			aCarpeta->mEntradas.emplace(Minusculas(aNombre), aNombre);
+		}
+	}
+	auto anItr = aLeidas.emplace(theCarpeta, std::move(aCarpeta)).first;
+	return anItr->second ? &*anItr->second : nullptr;
+}
+}
+
+bool PakInterface::PuedeAbrirse(std::string_view theFileName)
+{
+	if (mPakRecordMap.contains(NormalizePakPath(theFileName)))
+		return true;
+
+	std::string aRuta = Sexy::IsPathRooted(theFileName) ? std::string(theFileName) : Sexy::GetResourcePath(theFileName);
+	std::replace(aRuta.begin(), aRuta.end(), '\\', '/');
+	aRuta = Minusculas(aRuta);
+	// "." y ".." (y "//") los resuelve el sistema de archivos: con eso no se adivina
+	const size_t aBarra = aRuta.rfind('/');
+	if (aRuta.empty() || aRuta[0] != '/' || aRuta.find("/.") != std::string::npos ||
+		aRuta.find("//") != std::string::npos || aBarra == aRuta.size() - 1)
+		return true;
+	const CarpetaEnDisco* aCarpeta = LeerCarpeta(aRuta.substr(0, aBarra));
+	return aCarpeta && aCarpeta->mEntradas.contains(aRuta.substr(aBarra + 1));
+}
+#endif
