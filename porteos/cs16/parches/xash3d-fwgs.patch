@@ -591,6 +682,22 @@ static void IN_CollectInput( float *forward, float *side, float *pitch, float *y
 	IN_GyroFinalizeMove( forward, side, pitch, yaw );
 	Joy_FinalizeMove( forward, side, pitch, yaw );
