+#if XASH_EMSCRIPTEN
+#include <emscripten/emscripten.h>
+// Porteo web: los controles táctiles los dibuja la página (HTML) y le hablan al motor por acá.
+// La mirada se acumula (grados) hasta el próximo cuadro; el joystick queda fijo (-1..1) hasta
+// que la página lo cambie.
+static float porteo_yaw, porteo_pitch, porteo_forward, porteo_side;
+
+EMSCRIPTEN_KEEPALIVE void Porteo_Mirar( float yaw, float pitch )
+{
+	porteo_yaw += yaw;
+	porteo_pitch += pitch;
+}
+
+EMSCRIPTEN_KEEPALIVE void Porteo_Mover( float forward, float side )
+{
+	porteo_forward = forward;
+	porteo_side = side;
+}
+
+// un comando de consola, para el próximo cuadro ("+attack", "slot1", "buy"...)
+EMSCRIPTEN_KEEPALIVE void Porteo_Comando( const char *text )
+{
+	Cbuf_AddText( text );
+	Cbuf_AddText( "\n" );
+}
+
+// texto del teclado del teléfono (la página lo lee de un <input> de verdad): igual que el
+// SDL_TEXTINPUT de host_sdl2.c, UTF-8 convertido si el que escucha no lo acepta
+EMSCRIPTEN_KEEPALIVE void Porteo_Texto( const char *text )
+{
+	VGui_ReportTextInput( text );
+
+	for( ; *text; text++ )
+	{
+		int ch = (byte)*text;
+
+		if( !cls.accept_utf8 )
+			ch = Con_UtfProcessCharForce( ch );
+
+		if( ch )
+			CL_CharEvent( ch );
+	}
+}
+
+// teclas sueltas del teclado del teléfono: borrar, enter, escape
+EMSCRIPTEN_KEEPALIVE void Porteo_Tecla( int key, int down )
+{
+	Key_Event( key, down );
+}
+
+static int porteo_radio;
+
+void Porteo_ContarRadio( void )
+{
+	porteo_radio++;
+}
+
+// el estado para la página y para las pruebas: JSON en un búfer fijo
+EMSCRIPTEN_KEEPALIVE const char *Porteo_Estado( void )
+{
+	static char buf[768];
+	char nombre[64];
+	const char *arma = clgame.viewent.model ? COM_FileWithoutPath( clgame.viewent.model->name ) : "";
+	int jugadores = 0;
+
+	for( int i = 0; i < cl.maxclients && i < MAX_CLIENTS; i++ )
+	{
+		if( cl.players[i].name[0] )
+			jugadores++;
+	}
+
+	// el nombre del jugador, sin lo que rompería el JSON
+	Q_strncpy( nombre, Cvar_VariableString( "name" ), sizeof( nombre ));
+	for( char *p = nombre; *p; p++ )
+	{
+		if( *p == '"' || *p == '\\' || (byte)*p < 32 )
+			*p = '\'';
+	}
+
+	Q_snprintf( buf, sizeof( buf ),
+		"{\"estado\":%d,\"destino\":%d,\"mapa\":\"%s\",\"vida\":%d,\"pos\":[%.1f,%.1f,%.1f],\"ang\":[%.1f,%.1f,%.1f],\"pausa\":%d,\"tiempo\":%.2f,\"nombre\":\"%s\""
+		",\"arma\":\"%s\",\"anim\":%d,\"animT\":%.2f,\"fov\":%.1f,\"suelo\":%d,\"jugadores\":%d,\"radio\":%d}",
+		cls.state, cls.key_dest, clgame.mapname, cl.local.health,
+		cl.simorg[0], cl.simorg[1], cl.simorg[2],
+		cl.viewangles[0], cl.viewangles[1], cl.viewangles[2],
+		cl.paused, cl.time, nombre,
+		arma, cl.local.weaponsequence, cl.local.weaponstarttime, cl.local.scr_fov, cl.local.onground != -1, jugadores, porteo_radio );
+	return buf;
+}
+#endif // XASH_EMSCRIPTEN
+
