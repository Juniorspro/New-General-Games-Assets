+#if XASH_EMSCRIPTEN
+	// en el navegador no se puede quedar en un bucle: cada cuadro es una llamada desde
+	// requestAnimationFrame (simulate_infinite_loop: main no vuelve)
+	host_web_oldtime = oldtime;
+	emscripten_set_main_loop( Host_WebFrame, 0, 1 );
+#else
 	// main window message loop
 	while( host.status != HOST_CRASHED )
 	{
@@ -1342,6 +1392,7 @@ int EXPORT Host_Main( int argc, char **argv, const char *progname, int bChangeGa
 		COM_Frame( newtime - oldtime );
 		oldtime = newtime;
 	}
+#endif
 
 	return 0;
 }
