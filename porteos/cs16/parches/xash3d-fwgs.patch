+#if XASH_EMSCRIPTEN
+	{
+		// la página manda grados; el cliente después los multiplica por "sensitivity" (la del
+		// mouse): se divide acá, así el dedo gira lo que calculó la página (y con la mira de un
+		// rifle, lo que el juego achica por el zoom)
+		float sens = Cvar_VariableValue( "sensitivity" );
+
+		if( sens < 0.01f )
+			sens = 1.0f;
+		*forward += porteo_forward;
+		*side += porteo_side;
+		*yaw += porteo_yaw / sens;
+		*pitch += porteo_pitch / sens;
+		porteo_yaw = porteo_pitch = 0.0f;
+	}
+#endif
 
 	if( look_filter.value )
 	{
