+#if XASH_EMSCRIPTEN
+/*
+=================
+Porteo_MapaListo
+
+Porteo web: los datos de cada mapa se bajan recién cuando se lo pide. Antes de cargar un mapa
+se le pregunta a la página: si todavía no están, los trae y vuelve a mandar el mismo comando.
+=================
+*/
+qboolean Porteo_MapaListo( const char *cmd, const char *mapa )
+{
+	return EM_ASM_INT({
+		return Module.porteoMapa ? Module.porteoMapa( UTF8ToString( $0 ), UTF8ToString( $1 )) : 1;
+	}, cmd, mapa ) != 0;
+}
+
+// ¿Es un mapa del juego, aunque todavía no se haya bajado? (el menú y la rotación de mapas)
+qboolean Porteo_MapaExiste( const char *mapa )
+{
+	return EM_ASM_INT({
+		return Module.porteoMapaExiste ? Module.porteoMapaExiste( UTF8ToString( $0 )) : 0;
+	}, mapa ) != 0;
+}
+
+static double host_web_oldtime;
+
+static void Host_WebFrame( void )
+{
+	double newtime = Platform_DoubleTime();
+
+	if( host.status == HOST_CRASHED )
+	{
+		emscripten_cancel_main_loop();
+		return;
+	}
+
+	COM_Frame( newtime - host_web_oldtime );
+	host_web_oldtime = newtime;
+}
+#endif
+
 /*
 =================
 Host_Main
@@ -1335,6 +1379,12 @@ int EXPORT Host_Main( int argc, char **argv, const char *progname, int bChangeGa
 	// check after all configs were executed
