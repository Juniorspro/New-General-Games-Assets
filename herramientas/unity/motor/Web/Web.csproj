<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- El juego en el navegador: el IL original del juego (de JUEGO, la carpeta Managed del APK)
       sobre el motor (UnityEngine.CoreModule y las fachadas), con .NET para WebAssembly.
         dotnet publish -c Release -p:JUEGO=.../assets/bin/Data/Managed [-p:RunAOTCompilation=false] -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Porteo</AssemblyName>
    <RootNamespace>Porteo</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- el juego arma las rutas de sus textos con CultureInfo.Name y TwoLetterISOLanguageName
         (I18n/es/...) y tiene 10 idiomas, de alfabetos latinos, cirílico y CJK: hace falta ICU completo -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <WasmIncludeFullIcuData>true</WasmIncludeFullIcuData>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <!-- el IL compilado a WebAssembly: con el intérprete, un cuadro del mundo cuesta ~4,5 veces más
         de CPU (140 ms contra 30). Para probar rápido se puede apagar con -p:RunAOTCompilation=false -->
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">true</RunAOTCompilation>
    <!-- el motor llama a WebGL 2 directo (DllImport "porteo"): hace falta enlazar lo nativo -->
    <WasmBuildNative>true</WasmBuildNative>
    <EmccExtraLDFlags>-lGL -sMAX_WEBGL_VERSION=2 -sMIN_WEBGL_VERSION=2</EmccExtraLDFlags>
    <EmccInitialHeapSize>268435456</EmccInitialHeapSize>
    <EmccMaximumHeapSize>4294901760</EmccMaximumHeapSize>
    <!-- se recorta sólo la biblioteca de .NET: el juego y el motor quedan como están (Unity llama
         por reflexión a Awake, Update... y la propagación de constantes del recortador se rompe
         con el IL de UnityEngine.UI) -->
    <TrimMode>partial</TrimMode>
    <_ExtraTrimmerArgs>$(_ExtraTrimmerArgs) --disable-opt ipconstprop --disable-opt unreachablebodies</_ExtraTrimmerArgs>
    <NoWarn>$(NoWarn);MSB3277;CS1701;CS1702;IL2026;IL2075;IL2072;IL2070;IL2067;IL2057</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <NativeFileReference Include="nativo/porteo.c" />
    <!-- PhysX y su capa en C (fisica/compilar-physx.py arma libporteo_fisica.a): sin ella, el
         juego corre sin física (Simulacion avisa y sigue) -->
    <NativeFileReference Include="$(FISICA)" Condition="'$(FISICA)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UnityEngine/UnityEngine.CoreModule.csproj" />
    <ProjectReference Include="../Fachadas/*/*.csproj" Condition="'$(PERFIL)' == ''" />
  </ItemGroup>
  <!-- el código del juego, tal cual viene en el APK -->
  <!-- otro juego: sus ensamblados y sus fachadas vienen del perfil -->
  <Import Project="../perfiles/$(PERFIL)/juego.props" Condition="'$(PERFIL)' != ''" />
  <ItemGroup Condition="'$(JUEGO)' != '' And '$(PERFIL)' == ''">
    <Reference Include="Assembly-CSharp"><HintPath>$(JUEGO)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Assembly-UnityScript"><HintPath>$(JUEGO)/Assembly-UnityScript.dll</HintPath></Reference>
    <Reference Include="Logger"><HintPath>$(JUEGO)/Logger.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(JUEGO)/UnityEngine.UI.dll</HintPath></Reference>
    <!-- el recorte de .NET no puede adivinar lo que Unity llama por reflexión (Awake, Update...) -->
    <TrimmerRootAssembly Include="Assembly-CSharp;Assembly-UnityScript;Logger;UnityEngine.UI;UnityEngine.CoreModule" />
  </ItemGroup>
</Project>
