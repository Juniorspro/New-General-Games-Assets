<Project Sdk="Microsoft.NET.Sdk">
  <!-- El motor en consola, sin navegador: carga los datos exportados y corre cuadros (para
       depurar el ciclo de vida con el .NET de escritorio).
         dotnet run -c Release -p:JUEGO=.../assets/bin/Data/Managed, con los argumentos
         DATOS [escena] [cuadros] después del separador de dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PruebaMotor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);MSB3277;CS1701;CS1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UnityEngine/UnityEngine.CoreModule.csproj" />
    <ProjectReference Include="../Fachadas/*/*.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(JUEGO)' != ''">
    <Reference Include="Assembly-CSharp"><HintPath>$(JUEGO)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Assembly-UnityScript"><HintPath>$(JUEGO)/Assembly-UnityScript.dll</HintPath></Reference>
    <Reference Include="Logger"><HintPath>$(JUEGO)/Logger.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(JUEGO)/UnityEngine.UI.dll</HintPath></Reference>
  </ItemGroup>
</Project>
