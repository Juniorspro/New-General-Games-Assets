<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prepara el IL del juego para el .NET actual: agrega los métodos de interfaz que el recorte
       de Unity sacó (el runtime de hoy no carga un tipo al que le falta uno) y avisa de las
       referencias a la biblioteca de .NET que ya no existen. Ver Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
