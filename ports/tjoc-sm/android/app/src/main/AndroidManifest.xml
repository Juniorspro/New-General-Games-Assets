<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- (WebGL 2 si la placa sabe GLES 3; si no, el juego se arregla con WebGL 1) -->
  <uses-feature android:glEsVersion="0x00020000" android:required="true" />
  <!-- appCategory game: el sistema lo trata como juego (modo juego, el panel de juegos, prioridad) -->
  <application
      android:label="@string/nombre"
      android:icon="@mipmap/icono"
      android:roundIcon="@mipmap/icono"
      android:appCategory="game"
      android:isGame="true"
      android:hardwareAccelerated="true"
      android:largeHeap="true"
      android:usesCleartextTraffic="false"
      android:theme="@style/Tema">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:screenOrientation="sensorLandscape"
        android:resizeableActivity="false"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
