# La LLAVE nunca al repo: init deja la marca y la credencial donde se corre.
# El cliente sí es nuestro y va commiteado.
.rezona/
__pycache__/

# la clave con que se firma el APK: nunca al repo
*.keystore
*.jks

# el directorio desde el que se despliega a Pages: se arma copiando docs/paginas
/sitio/
.wrangler/

# el token de Mint: nunca al repo (igual vive en ~/.mint, pero por las dudas)
.mint/

# secretos de la prueba local: NUNCA se suben
.dev.vars

# juegos de terceros porteados: el repo es público y no se redistribuyen (ver PORTEO.md §11)
/bus-stop/
/entrega-*/

# lo que compila dotnet en las herramientas de Unity (ripear, verificar)
herramientas/unity/**/bin/
herramientas/unity/**/obj/

# los datos del juego que saca exportar.py del APK: nunca al repo
porteos/slime-rancher/web/datos

# Geometry Dash: lo que saca armar-datos.py del APK (dibujos, niveles, música) es del juego
porteos/gd/datos/
