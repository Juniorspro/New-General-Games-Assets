# ── Qué transporte usar ──────────────────────────────────────────────
# baileys = tu número por WebSocket. Ligero, sin navegador. (recomendado)
# web     = tu número por WhatsApp Web + Chromium. Más pesado.
# cloud   = API oficial de Meta. Número aparte y webhook público.
PROVEEDOR=baileys

# Solo para baileys: con tu número vincula por CÓDIGO de 8 dígitos.
# Si lo dejas vacío, imprime un QR. Formato internacional, sin +.
TU_NUMERO=

# ── Solo para PROVEEDOR=cloud ────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-algo-tuyo
GRAPH_VERSION=v23.0
PUERTO=3000

# ── IA: pon UNA sola clave, el bot detecta cuál ──────────────────────
# Gratis, sin tarjeta:
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# De pago por uso:
ANTHROPIC_API_KEY=

# Opcional: forzar proveedor y modelo en vez de la detección automática.
# Los nombres de modelo cambian seguido: usa /modelos para ver los vigentes.
IA_PROVEEDOR=
IA_MODELO=

# Opcional: cualquier otra API compatible con OpenAI
IA_API_KEY=
IA_BASE_URL=
